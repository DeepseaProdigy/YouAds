# Set this in the environment that launches orbis_service/Uvicorn, not in the
# browser. It is shown here only as a local-development reference.
REACTOR_API_KEY=replace_with_your_reactor_api_key
# Next.js server -> local Python service.
ORBIS_SERVICE_URL=http://127.0.0.1:8000
# Browser-safe relay origin only; never expose a Reactor key or JWT.
NEXT_PUBLIC_ORBIS_SERVICE_URL=http://localhost:8000
OPENAI_API_KEY=replace_with_your_openai_api_key
# Optional override; defaults to gpt-4.1 then falls back to gpt-4o
# OPENAI_MODEL=gpt-4.1
GEMINI_API_KEY=replace_with_your_gemini_api_key
